rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check connection test document
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidDateId(dateISO) {
      return dateISO is string && dateISO.size() >= 8 && dateISO.size() <= 32;
    }

    function isValidSchedule(data, userId) {
      return data.userId == userId &&
        data.date is string &&
        (!('ruleOfThree' in data) || (data.ruleOfThree is list && data.ruleOfThree.size() <= 10)) &&
        (!('blocks' in data) || (data.blocks is list && data.blocks.size() <= 100));
    }

    function isValidTemplate(data, userId) {
      return data.userId == userId &&
        data.id is string &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 150 &&
        (!('blocks' in data) || (data.blocks is list && data.blocks.size() <= 100));
    }

    // User-isolated daily schedules
    match /users/{userId}/schedules/{dateISO} {
      allow get: if isOwner(userId) && isValidDateId(dateISO);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidDateId(dateISO) && isValidSchedule(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidDateId(dateISO) && isValidSchedule(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidDateId(dateISO);
    }

    // User-isolated schedule templates
    match /users/{userId}/templates/{templateId} {
      allow get: if isOwner(userId) && isValidId(templateId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(templateId) && isValidTemplate(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(templateId) && isValidTemplate(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(templateId);
    }
  }
}
